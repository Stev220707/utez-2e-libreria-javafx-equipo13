<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.utez2elibreriajavafxequipo13.controller.DetailController"
      style="-fx-background-color: white; -fx-border-color: #3498db; -fx-border-width: 2;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Ficha Tecnica" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
    <Separator/>
    <Label fx:id="datos" style="-fx-font-size: 15px; -fx-line-spacing: 10;" wrapText="true"/>
    <Button text="Cerrar" onAction="#cerrar" style="-fx-background-color: #95a5a6;"/>
</VBox>